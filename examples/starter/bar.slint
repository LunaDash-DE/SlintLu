import { TrayIcons } from "tray.slint";
import { PanelWindow, Shell, Clock, System, Battery, Audio, Workspaces, Media, Network, Notifications, Session, Shared, Theme } from "@slintlu";

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> accent: Theme.text;
    in property <bool> highlighted;
    callback clicked();
    callback scrolled(delta: length);

    height: 24px;
    width: max(24px, label.preferred-width + 20px);
    border-radius: 12px;
    background: root.highlighted ? Theme.accent : touch.pressed ? Theme.border : touch.has-hover ? Theme.surface-alt : Theme.surface;
    animate background { duration: 120ms; }

    label := Text {
        text: root.text;
        color: root.highlighted ? Theme.background : root.accent;
        font-size: 13px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            accept
        }
    }
}

export component Bar inherits PanelWindow {
    namespace: "slintlu-bar";
    anchor-top: true;
    anchor-left: true;
    anchor-right: true;
    preferred-height: 34px;
    background: Theme.background.with-alpha(0.92);

    init => {
        Clock.time-format = "%H:%M:%S";
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        // Chips are 24px high; the padding makes the layout (and so the bar) 34px.
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 6px;

        // Workspaces of this screen.
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for ws in Workspaces.all: Chip {
                visible: ws.output == Shell.screen.name;
                text: ws.name != "" ? ws.name : ws.index;
                highlighted: ws.active;
                accent: ws.urgent ? Theme.red : Theme.text;
                clicked => { Workspaces.focus(ws.id); }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: Workspaces.focused-window.title;
            color: Theme.text-muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        Chip {
            visible: Media.player.title != "";
            text: (Media.player.playing ? "▶ " : "⏸ ") + Media.player.title;
            accent: Theme.magenta;
            clicked => { Media.play-pause(); }
        }

        Chip { text: Clock.date + "  " + Clock.time; accent: Theme.yellow; }

        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            TrayIcons { }
            Chip {
                text: "cpu " + round(System.cpu * 100) + "%";
                accent: System.cpu > 0.8 ? Theme.red : Theme.green;
            }
            Chip { text: "mem " + round(System.memory * 100) + "%"; accent: Theme.cyan; }
            Chip {
                visible: Audio.available;
                text: Audio.output.muted ? "muted" : "vol " + round(Audio.output.volume * 100) + "%";
                accent: Theme.cyan;
                clicked => { Audio.toggle-muted(); }
                scrolled(delta) => {
                    Audio.set-volume(clamp(Audio.output.volume + (delta > 0 ? 0.05 : -0.05), 0, 1.5));
                }
            }
            Chip {
                visible: Battery.available;
                text: (Battery.charging ? "chg " : "bat ") + round(Battery.level * 100) + "%";
                accent: Battery.level < 0.2 && !Battery.charging ? Theme.red : Theme.green;
            }
            Chip {
                visible: Network.available;
                text: !Network.connected ? "offline" : Network.kind == "wifi" ? Network.name + " " + round(Network.strength * 100) + "%" : Network.kind;
                accent: Network.online ? Theme.green : Theme.yellow;
            }
            Chip {
                visible: Notifications.available;
                text: Notifications.do-not-disturb ? "dnd" : "notif " + Notifications.count;
                accent: Theme.yellow;
                clicked => { Notifications.set-do-not-disturb(!Notifications.do-not-disturb); }
            }
            Chip { visible: Workspaces.keyboard-layout != ""; text: Workspaces.keyboard-layout; accent: Theme.blue; }
            Chip { text: "apps"; accent: Theme.magenta; clicked => { Shared.toggle("launcher"); } }
            Chip { text: "lock"; accent: Theme.red; clicked => { Session.lock(); } }
        }
    }
}
