// User activity. Settings apply to the whole shell. React to `idle` with a local property and
// a `changed` handler, e.g.
//     property <bool> idle: Idle.idle;
//     changed idle => { if idle { Shell.exec("niri msg action power-off-monitors"); } }
export global Idle {
    // Whether idle detection works on this compositor (ext-idle-notify-v1).
    in property <bool> available;
    // No input for `timeout`.
    in property <bool> idle;
    in property <duration> timeout: 300s;
    // Lock the session after this much inactivity; 0 disables it.
    in property <duration> lock-after: 0s;
    // The screen is kept awake (a "caffeine" toggle). Needs a visible shell window.
    in property <bool> inhibited;

    callback set-timeout(timeout: duration);
    callback set-lock-after(timeout: duration);
    callback set-inhibited(inhibited: bool);
}
