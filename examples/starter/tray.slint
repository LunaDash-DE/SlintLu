// System tray icons for the bar, and the menu panel they open.

import { PanelWindow, Tray, TrayItemInfo, Shell, Workspaces, Theme } from "@slintlu";

export component TrayIcons inherits HorizontalLayout {
    spacing: 6px;
    alignment: end;
    for item in Tray.items: Rectangle {
        visible: item.status != "passive";
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: touch.has-hover ? Theme.surface-alt : transparent;
        Image { source: item.icon; width: 18px; height: 18px; }
        touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    Tray.open-menu(item.id);
                }
            }
            clicked => {
                if item.item-is-menu { Tray.open-menu(item.id); } else { Tray.activate(item.id); }
            }
            scroll-event(event) => {
                Tray.scroll(item.id, event.delta-y > 0 ? -1 : 1);
                accept
            }
        }
    }
}

export component TrayMenu inherits PanelWindow {
    namespace: "slintlu-tray-menu";
    layer: overlay;
    anchor-top: true;
    anchor-right: true;
    margin-top: 38px;
    margin-right: 8px;
    exclusive-mode: ignore;
    keyboard-mode: on-demand;
    preferred-width: 260px;
    shown: Tray.menu-owner != "" && (Workspaces.focused-output == "" || Workspaces.focused-output == Shell.screen.name);

    Rectangle {
        border-radius: 10px;
        background: Theme.background.with-alpha(0.96);
        border-width: 1px;
        border-color: Theme.surface-alt;
        VerticalLayout {
            padding: 6px;
            for entry in Tray.menu: Rectangle {
                height: entry.separator ? 9px : 28px;
                border-radius: 6px;
                background: !entry.separator && entry.enabled && touch.has-hover ? Theme.surface-alt : transparent;
                if entry.separator: Rectangle { height: 1px; background: Theme.surface-alt; }
                if !entry.separator: HorizontalLayout {
                    padding-left: 10px + entry.depth * 14px;
                    padding-right: 10px;
                    spacing: 6px;
                    Text {
                        width: 14px;
                        text: entry.checked ? (entry.toggle-type == "radio" ? "●" : "✓") : "";
                        color: Theme.green;
                        vertical-alignment: center;
                    }
                    Text {
                        text: entry.label;
                        color: entry.enabled ? Theme.text : Theme.text-muted.with-alpha(0.7);
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text { text: entry.has-children ? "›" : ""; color: Theme.text-muted.with-alpha(0.7); vertical-alignment: center; }
                }
                touch := TouchArea {
                    enabled: entry.enabled && !entry.separator && !entry.has-children;
                    clicked => { Tray.menu-activate(entry.id); }
                }
            }
        }
    }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { Tray.close-menu(); return accept; }
            reject
        }
    }
}
