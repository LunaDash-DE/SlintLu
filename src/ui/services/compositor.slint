// The compositor itself: its name, requests it sends to the shell (keyboard shortcuts that
// open shell UI) and compositor-specific commands.
export global Compositor {
    // "lunadash", "niri", "hyprland", "sway", … or "unknown".
    in property <string> name;
    // The latest request, e.g. "launcher" (argument "true"/"false"), "settings" (argument: the
    // page), "wallpaper-picker", "control-center", "clipboard", "power-menu". React to changes
    // of `request-serial`.
    in property <string> request;
    in property <string> request-argument;
    in property <int> request-serial;
    // Whether `command` is supported (LunaDash).
    in property <bool> has-commands;
    // The wallpaper image when the compositor manages one (LunaDash), as a local path; empty
    // otherwise. Shells can show it instead of their own wallpaper setting.
    in property <string> wallpaper;
    // A still frame of a video wallpaper (LunaDash); empty for images.
    in property <string> wallpaper-poster;
    // Whether the compositor plays the (video) wallpaper itself below the shell's surfaces;
    // shells should keep their wallpaper transparent then.
    in property <bool> wallpaper-live;
    // The desktop language chosen in the compositor (LunaDash), e.g. "zh_TW"; empty otherwise.
    in property <string> language;

    // A compositor-specific command, e.g. command("launch-default", "terminal") on LunaDash.
    callback command(method: string, value: string);
}
