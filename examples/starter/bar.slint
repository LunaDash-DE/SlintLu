import { PanelWindow, Shell, Clock, System, Battery, Audio, Workspaces } from "@slintlu";

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> accent: #cdd6f4;
    in property <bool> highlighted;
    callback clicked();
    callback scrolled(delta: length);

    height: 24px;
    width: max(24px, label.preferred-width + 20px);
    border-radius: 12px;
    background: root.highlighted ? #89b4fa : touch.pressed ? #585b70 : touch.has-hover ? #45475a : #313244;
    animate background { duration: 120ms; }

    label := Text {
        text: root.text;
        color: root.highlighted ? #1e1e2e : root.accent;
        font-size: 13px;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        scroll-event(event) => {
            root.scrolled(event.delta-y);
            accept
        }
    }
}

export component Bar inherits PanelWindow {
    namespace: "slintlu-bar";
    anchor-top: true;
    anchor-left: true;
    anchor-right: true;
    preferred-height: 34px;
    background: #1e1e2ee6;

    init => {
        Clock.time-format = "%H:%M:%S";
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        // Chips are 24px high; the padding makes the layout (and so the bar) 34px.
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 6px;

        // Workspaces of this screen.
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for ws in Workspaces.all: Chip {
                visible: ws.output == Shell.screen.name;
                text: ws.name != "" ? ws.name : ws.index;
                highlighted: ws.active;
                accent: ws.urgent ? #f38ba8 : #cdd6f4;
                clicked => { Workspaces.focus(ws.id); }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: Workspaces.focused-window.title;
            color: #bac2de;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }

        Chip { text: Clock.date + "  " + Clock.time; accent: #f9e2af; }

        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            Chip {
                text: "cpu " + round(System.cpu * 100) + "%";
                accent: System.cpu > 0.8 ? #f38ba8 : #a6e3a1;
            }
            Chip { text: "mem " + round(System.memory * 100) + "%"; accent: #94e2d5; }
            Chip {
                visible: Audio.available;
                text: Audio.output.muted ? "muted" : "vol " + round(Audio.output.volume * 100) + "%";
                accent: #89dceb;
                clicked => { Audio.toggle-muted(); }
                scrolled(delta) => {
                    Audio.set-volume(clamp(Audio.output.volume + (delta > 0 ? 0.05 : -0.05), 0, 1.5));
                }
            }
            Chip {
                visible: Battery.available;
                text: (Battery.charging ? "chg " : "bat ") + round(Battery.level * 100) + "%";
                accent: Battery.level < 0.2 && !Battery.charging ? #f38ba8 : #a6e3a1;
            }
            Chip { visible: Workspaces.keyboard-layout != ""; text: Workspaces.keyboard-layout; accent: #b4befe; }
            Chip { text: "apps"; accent: #cba6f7; clicked => { Shell.exec("fuzzel || wofi --show drun"); } }
        }
    }
}
