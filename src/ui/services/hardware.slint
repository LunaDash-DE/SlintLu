// The screen backlight (laptops). External monitors are not covered.
export global Brightness {
    in property <bool> available;
    // 0..1
    in property <float> level;
    callback set(level: float);
}

export struct BluetoothDeviceInfo {
    // Object path, used by `connect` / `disconnect`.
    path: string,
    address: string,
    name: string,
    // Icon name from the icon theme, e.g. "audio-headset".
    icon: string,
    connected: bool,
    paired: bool,
    // Battery level in 0..1, or -1 when unknown.
    battery: float,
}

// Bluetooth through BlueZ.
export global Bluetooth {
    // BlueZ is running and an adapter exists.
    in property <bool> available;
    in property <bool> powered;
    // Paired and connected devices, connected first.
    in property <[BluetoothDeviceInfo]> devices;
    in property <int> connected-count;

    callback set-powered(powered: bool);
    callback connect(path: string);
    callback disconnect(path: string);
}
