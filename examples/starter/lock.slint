// The lock screen. Lock with `slintlu msg call Session.lock`, `loginctl lock-session` or the
// bar; SlintLu also locks before the machine suspends.

import { LockWindow, Session, Clock, Shell, Theme } from "@slintlu";

export component LockScreen inherits LockWindow {
    background: Theme.background.darker(0.4);

    changed width => { password.focus(); }

    VerticalLayout {
        alignment: center;
        spacing: 18px;

        Text {
            text: Clock.time;
            font-size: 72px;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: Clock.date;
            font-size: 20px;
            color: Theme.text-muted;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 320px;
                height: 48px;
                border-radius: 24px;
                background: Theme.surface;
                border-width: 2px;
                border-color: Session.message != "" ? Theme.red : password.has-focus ? Theme.accent : Theme.surface-alt;
                password := TextInput {
                    x: 20px;
                    width: parent.width - 40px;
                    input-type: InputType.password;
                    color: Theme.text;
                    font-size: 18px;
                    vertical-alignment: center;
                    enabled: !Session.authenticating;
                    accepted => {
                        Session.authenticate(self.text);
                        self.text = "";
                    }
                }
                Text {
                    x: 20px;
                    height: parent.height;
                    visible: password.text == "";
                    text: Session.authenticating ? "Checking…" : "Password for " + Session.user;
                    color: Theme.text-muted.with-alpha(0.7);
                    font-size: 16px;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: Session.message;
            color: Theme.red;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}
