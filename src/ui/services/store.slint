// Settings that survive restarts, stored per shell in $XDG_STATE_HOME/slintlu.
// Read reactively by passing `Store.revision`:
//     property <string> wallpaper: Store.get-string("wallpaper", "", Store.revision);
export global Store {
    // Increases on every change.
    in property <int> revision;
    pure callback get-string(key: string, fallback: string, revision: int) -> string;
    pure callback get-number(key: string, fallback: float, revision: int) -> float;
    pure callback get-bool(key: string, fallback: bool, revision: int) -> bool;
    callback set-string(key: string, value: string);
    callback set-number(key: string, value: float);
    callback set-bool(key: string, value: bool);
    callback remove(key: string);
}
