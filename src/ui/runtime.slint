import { PanelSettings, Screen } from "types.slint";

// Information about the running shell and actions it can perform.
export global Shell {
    // The screen this window instance is shown on.
    in property <Screen> screen;
    // All connected screens.
    in property <[Screen]> screens;
    // The renderer in use: "software", "opengl" or "vulkan".
    in property <string> renderer;
    // The compositor, e.g. "niri", "hyprland", "sway" or "unknown".
    in property <string> compositor;
    in property <string> version;
    // Directory of SlintLu's shared assets (res/ in the SlintLu repository), e.g. for
    // Files.image(Shell.resources + "/icons/wifi.svg"). Icons are easier through `Icon`.
    in property <string> resources;

    // Runs a command line through `sh -c`, detached from the shell.
    callback exec(command: string);
    // An environment variable of the shell process ("" when unset).
    pure callback env(name: string) -> string;
    // Reloads the shell configuration.
    callback reload();
    // Exits SlintLu.
    callback quit();
}

// Internal channel through which windows describe themselves to the runtime.
export global SlintLuRuntime {
    // Set once the services are connected; base windows then call their `ready` callback.
    in property <bool> ready;
    in-out property <string> kind;
    in-out property <PanelSettings> panel;
    in-out property <string> app-id;
    callback panel-changed();
}
