# systemd user service for SlintLu.
#   cp dist/slintlu.service ~/.config/systemd/user/
#   systemctl --user enable --now slintlu.service
# The compositor must import WAYLAND_DISPLAY into the systemd user environment (niri, Sway via
# `exec systemctl --user import-environment`, Hyprland with uwsm …) and start
# graphical-session.target.

[Unit]
Description=SlintLu desktop shell
Documentation=https://github.com/LunaDash-DE/SlintLu
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/slintlu
ExecReload=kill -HUP $MAINPID
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
